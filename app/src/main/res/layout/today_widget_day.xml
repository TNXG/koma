<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="5dp"
        android:paddingEnd="5dp">

        <TextView
            android:id="@+id/widget_date"
            style="@style/WidgetAgenda.Title"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform" />

        <TextView
            android:id="@+id/widget_week"
            style="@style/WidgetAgenda.Caption"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/inter500"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_header_overflow"
            style="@style/WidgetAgenda.Overflow"
            android:layout_marginStart="6dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/widget_rows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_day_header_gap"
        android:divider="@drawable/today_widget_course_gap"
        android:orientation="vertical"
        android:showDividers="middle"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_overflow"
        style="@style/WidgetAgenda.Caption"
        android:layout_marginStart="5dp"
        android:layout_marginTop="3dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="5dp"
        android:paddingEnd="5dp">

        <TextView
            android:id="@+id/widget_message"
            style="@style/WidgetAgenda.Course"
            android:layout_width="match_parent"
            android:text="@string/widget_description" />

        <TextView
            android:id="@+id/widget_hint"
            style="@style/WidgetAgenda.Caption"
            android:layout_width="match_parent"
            android:layout_marginTop="4dp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
